# ============================================================
# AI 政策搜索智能体 · 服务器 .env 模板
# 用法：cp deploy/.env.example deploy/.env，然后改两处密码 + 填 LLM Key
# ============================================================

# ---------- MySQL 密码（两处必须一致！）----------
# compose 用 MYSQL_ROOT_PASSWORD 初始化 root；backend 用 DB_PASSWORD 连 ai_policy 用户
MYSQL_ROOT_PASSWORD=改成强密码A
DB_PASSWORD=改成强密码A

# 后端读的账号（compose 已固定为 ai_policy，这里只是后端进程自己的默认值）
DB_ENABLED=1
DB_USER=ai_policy
DB_NAME=ai_policy

# ---------- 大模型 ----------
# 填入智谱开放平台的 Key（https://open.bigmodel.cn ），与本地 .env 里的 LLM_API_KEY 相同
LLM_PROVIDER=auto
LLM_API_KEY=在这里填你的智谱Key
LLM_MODEL=glm-4.5-flash
LLM_THINKING=off

# 免费档高峰期慢，超时与重试保持默认即可（详见 app/config.py）
# LLM_TIMEOUT=300
# LLM_MAX_RETRIES=1

# ---------- 检索 ----------
# SEARCH_WORKERS=4
# SEARCH_MAX_ITEMS=10

# ---------- 其它 ----------
# 服务器上不重新转换 bootstrap 数据（镜像内无 node，保持 0）
BOOTSTRAP_AUTO_REFRESH=0
