# ============================================================
# AI 政策搜索智能体 · 本地后端配置示例
# 复制为 .env 后按需修改即可（零依赖解析，无需 python-dotenv）
# ============================================================

# ---------- 服务 ----------
# HOST=127.0.0.1
# PORT=8000
# GUI_DIR=../gui-prototype

# ---------- 大模型（默认免费） ----------
# 默认 LLM_PROVIDER=auto：未填 LLM_API_KEY 时自动使用本地免费规则引擎
# （离线、确定性、无需联网，可完整跑通「解析→抓取→清洗→结构化→分类→简报」全链路）
#
# 想接真实大模型，取消下面注释并填入自己的 Key。
# 推荐免费额度：智谱 GLM —— **glm-4.5-flash**（能力比 glm-4-flash 高一档，免费）
#   ⚠ glm-4.7-flash 虽也是官方免费档，但实测高峰期 429「访问量过大」频繁，不建议单独依赖；
#   ⚠ glm-4.5-flash 是**思考型模型**：默认把输出预算烧在推理上、正文为空，
#     必须配 LLM_THINKING=off（默认已是 off，见下），否则查询理解会超时、简报会退化成规则文案。
LLM_PROVIDER=auto
# LLM_API_KEY=
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4.5-flash

# ── 按用途分模型（三用途可各配各的；不配就继承上面那套全局值）────────────
# 四个用途：
#   query   查询理解（先解析、再检索）：输出只有几十 token，跑在 20s 硬等待窗里 → 最需要「快」
#   extract 结构化抽取（把候选政策吐成 JSON）：长输出，受输出 token 上限约束
#   chat    政策对话（详情页右栏问答）
#   brief   简报综述（导出时写 180–300 字）
# 每个用途都支持：LLM_MODEL_<用途> / LLM_BASE_URL_<用途> / LLM_API_KEY_<用途> /
#                 LLM_THINKING_<用途> / LLM_TIMEOUT_<用途> / LLM_MAX_TOKENS_<用途>
# 例：解析与抽取用快的免费档，对话与简报用更会写的那档：
# LLM_MODEL_QUERY=glm-4-flash
# LLM_MODEL_EXTRACT=glm-4-flash
# LLM_MODEL_CHAT=glm-4.5-flash
# LLM_MODEL_BRIEF=glm-4.5-flash
# 例：简报想要更好的文采就给它单独开思考（单次约 20s，仍在 60s 预算内）：
# LLM_THINKING_BRIEF=on

# 思考开关（GLM-4.5/4.7 这类思考型模型）：off（默认）/ on / auto
#   off  → 下发 thinking={"type":"disabled"}，关掉推理、把 token 全留给正文（**默认，推荐**）
#   on   → 下发 enabled，推理更充分但慢（实测同一问题 11~24s 且可能烧光输出预算）
#   auto → 什么都不下发，交给服务端默认行为
# 只在模型名含 glm 时下发（其它端点不认这个字段，可能直接 400）；
# 客户端另有「只有推理没有正文 → 自动关思考重试一次」的自愈，配错也不会空手而归。
# LLM_THINKING=off

# 其它等价的免费/本地选项：
#   SiliconFlow      LLM_BASE_URL=https://api.siliconflow.cn/v1     LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
#   OpenRouter       LLM_BASE_URL=https://openrouter.ai/api/v1      LLM_MODEL=deepseek/deepseek-chat-v3-0324:free
#   本地 Ollama      LLM_BASE_URL=http://127.0.0.1:11434/v1         LLM_MODEL=qwen2.5:7b   (LLM_API_KEY 随便填)

# 单次模型调用超时（秒）
# ★ 免费档实测约 20 tokens/s，一次完整抽取（~2300 tokens 输出）需要 ~120s，
#   所以默认给到 300s；设得太小会被硬掐断并误报「网络不可达」。
# LLM_TIMEOUT=300

# 单次生成上限（tokens）。10 条政策约需 2300 tokens，设太小会让 JSON 被截断。
# LLM_MAX_TOKENS=4096

# 瞬时故障重试：免费档高峰期的 429（限流）/ 5xx（服务端操作失败）会退避重试。
# 每次尝试本身就是一次完整生成（~180s），次数不宜调大；401/403/404 不重试。
# LLM_MAX_RETRIES=1
# LLM_RETRY_BACKOFF=2.0

# 代理策略：auto / 0 / 1
#   auto（默认）—— 直连优先；仅当直连出现连通性错误时才回退系统代理
#   0          —— 强制直连（忽略 http_proxy / https_proxy）
#   1          —— 强制走系统代理（企业内网场景）
# ★ 本机若配了失效的 http_proxy（常见于各类客户端注入的本地代理端口），
#   保持 auto 即可自动绕开，无需手工 unset 环境变量。
# LLM_USE_PROXY=auto

# ---------- 检索 ----------
# 线程池大小（同时进行的检索任务数）
# SEARCH_WORKERS=4
# 单次检索最多产出政策条数
# SEARCH_MAX_ITEMS=10
# 内存中保留的历史任务数（超出按 LRU 淘汰）
# SEARCH_KEEP_TASKS=50
# 单次检索最短耗时（毫秒），避免进度一闪而过、看不清过程
# SEARCH_MIN_DURATION_MS=2600

# ---------- MySQL（账号体系 + 检索记录持久化） ----------
# 用途：注册用户写入 users 表；登录签发 Bearer Token（sessions 表）；
#      每次检索的条件与结果写入 search_records，登录后直接回放，无需重复检索。
# 服务启动时自动建库建表（CREATE ... IF NOT EXISTS），库名默认 ai_policy。
#
# 关掉：DB_ENABLED=0 —— 账号/历史接口返回 503，检索主链路照常（游客模式）。
# SQLite 兜底：DB_ENABLED=sqlite —— 账号/历史改用零依赖文件库（backend/ai_policy.sqlite3），
#   免装 MySQL，注册/登录/历史/对话全部可用；此时下面的 DB_HOST 等连接参数被忽略。
#   文件位置可用 DB_SQLITE_PATH 覆盖。
DB_ENABLED=1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_policy
DB_CHARSET=utf8mb4
# 连接池大小与连接超时（秒）
# DB_POOL_SIZE=5
# DB_CONNECT_TIMEOUT=5
# 启动时自动建库建表（首次部署保持 1 即可）
# DB_AUTO_INIT=1
# 登录会话有效期（天）：登录一次即记住，超过该天数自动失效、需重新登录。
# 前端 AUTH.ttlDays 与本值保持一致（服务端登录响应里下发 ttlDays）。
# AUTH_TOKEN_TTL_DAYS=7
# 单用户检索历史保留条数上限（0 = 不限）
# HISTORY_KEEP_PER_USER=200

# ---------- bootstrap 数据 ----------
# 启动时自动从 test_date.js 重新生成 bootstrap.json
# BOOTSTRAP_AUTO_REFRESH=1
